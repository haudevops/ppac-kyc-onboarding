# =============================================================================
# KYC App - build-time configuration
# Copy to .env and adjust. Loaded with:  flutter run --dart-define-from-file=.env
# (the Android Studio / VS Code run configurations already pass this flag).
#
# These values are compiled into the app binary: never put secrets here.
# After editing this file, stop the app and run it again (hot reload/restart is not enough).
# =============================================================================

# Base URL of kyc_service (without /api/v1).
# Leave empty to use emulator defaults (Android emulator: http://10.0.2.2:3000, iOS simulator: http://localhost:3000).
#
# Android real device over USB: run `adb reverse tcp:3000 tcp:3000`, then use http://localhost:3000
# iPhone real device / Wi-Fi: use your Mac's name (`scutil --get LocalHostName`) + .local,
#   e.g. http://Haus-MacBook-Pro.local:3000, or its IP (`ipconfig getifaddr en0`), e.g. http://192.168.1.10:3000
# Keep PUBLIC_BASE_URL in kyc_service/.env equal to this value, otherwise uploaded images won't display.
API_BASE_URL=http://localhost:3000

# Network
API_CONNECT_TIMEOUT_MS=10000
API_RECEIVE_TIMEOUT_MS=20000
API_SEND_TIMEOUT_MS=60000
API_MAX_RETRIES=3

# How often the verification status is polled after submitting
KYC_STATUS_POLL_INTERVAL_MS=2000

# Block screenshots / screen recording on Android and hide the app content in the app switcher.
# Set to false ONLY while recording the demo video, then switch it back.
PROTECT_SCREEN=true
