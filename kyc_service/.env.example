# =============================================================================
# KYC Service - environment configuration
# Copy to `.env` and adjust. Every value is validated at startup (src/config/env.ts).
# =============================================================================

# --- Server ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public base URL of this API (used to build local presigned file URLs).
# When testing from a phone/emulator use your LAN IP, e.g. http://192.168.1.10:3000
# (Android emulator: http://10.0.2.2:3000)
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated allowed origins, or * for any (mobile apps don't need CORS).
CORS_ORIGINS=*
# Set to true when running behind a reverse proxy / load balancer.
TRUST_PROXY=false
LOG_LEVEL=info

# --- Database (Prisma) ---------------------------------------------------------
# SQLite file (relative to prisma/schema.prisma). connection_limit=1 serialises writes so the API
# and the review worker never hit SQLITE_BUSY. For PostgreSQL change the provider in
# prisma/schema.prisma and use e.g. postgresql://user:pass@localhost:5432/kyc
DATABASE_URL="file:./dev.db?connection_limit=1"

# --- Auth (JWT) -----------------------------------------------------------------
# Use long random values, different for each secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Values starting with "change-me" are rejected when NODE_ENV=production.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=kyc-service
JWT_AUDIENCE=kyc-app
BCRYPT_SALT_ROUNDS=12

# Per-IP limit for /auth/register, /auth/login, /auth/refresh
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100

# --- File storage -----------------------------------------------------------------
# local : files on disk under LOCAL_STORAGE_DIR, served via HMAC-signed expiring URLs
#         (zero setup - same client flow as S3/R2 presigned URLs)
# s3    : Cloudflare R2 / AWS S3 / MinIO (S3-compatible API)
STORAGE_DRIVER=local

LOCAL_STORAGE_DIR=./storage
LOCAL_STORAGE_SIGNING_SECRET=change-me-local-file-url-signing-secret-32chars

# --- Cloudflare R2 (STORAGE_DRIVER=s3) ---------------------------------------------
# 1. Cloudflare dashboard -> R2 -> Create bucket (e.g. "kyc-documents"). Keep it PRIVATE
#    (do NOT enable public access / r2.dev subdomain).
# 2. R2 -> Manage R2 API Tokens -> Create API token
#      Permissions: "Object Read & Write", scoped to that bucket only.
#    Copy the Access Key ID and Secret Access Key (shown once).
# 3. Your Account ID is on the R2 overview page. The endpoint is
#      https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#    Either set R2_ACCOUNT_ID (endpoint is derived) or S3_ENDPOINT explicitly.
# 4. Only needed for browser/Flutter-web direct uploads: add a CORS policy on the bucket
#    (see README "Cloudflare R2 setup").
R2_ACCOUNT_ID=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=kyc-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- AWS S3 instead of R2 --------------------------------------------------------------
# Leave R2_ACCOUNT_ID and S3_ENDPOINT empty, set S3_REGION=ap-southeast-1 (etc.) and
# S3_FORCE_PATH_STYLE=false.
# --- MinIO (local S3) --------------------------------------------------------------------
# S3_ENDPOINT=http://localhost:9000, S3_REGION=us-east-1, S3_FORCE_PATH_STYLE=true

# Optional key prefix inside the bucket (e.g. "uat")
STORAGE_KEY_PREFIX=

# Presigned URL lifetimes (seconds) and max image size
PRESIGNED_DOWNLOAD_TTL_SECONDS=300
PRESIGNED_UPLOAD_TTL_SECONDS=600
MAX_UPLOAD_SIZE_MB=5

# --- Simulated KYC review --------------------------------------------------------------
KYC_REVIEW_WORKER_ENABLED=true
# Decision is made this long after submission (requirement: 10 seconds)
KYC_AUTO_REVIEW_DELAY_MS=10000
KYC_REVIEW_POLL_INTERVAL_MS=1000
# rule     : full name contains "reject" -> REJECTED (final)
#            full name contains "retake" -> RESUBMISSION_REQUESTED (selfie) on the first submission
#            expired ID / missing photo  -> RESUBMISSION_REQUESTED (those items)
#            otherwise                   -> APPROVED
# approve | reject | resubmit : always that outcome   random : any of the three
KYC_AUTO_REVIEW_MODE=rule

# Exposes POST /api/v1/kyc/dev/review (force a decision). Defaults to true unless production.
ENABLE_DEV_ENDPOINTS=true
