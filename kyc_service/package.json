{
  "name": "kyc-service",
  "version": "1.0.0",
  "private": true,
  "description": "KYC Onboarding REST API - Node.js, TypeScript, Express 5, Prisma, S3/Cloudflare R2",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "setup": "prisma generate && prisma db push",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:e2e": "rm -f prisma/test.db prisma/test.db-wal prisma/test.db-shm prisma/test.db-journal && DATABASE_URL='file:./test.db?connection_limit=1' prisma db push --accept-data-loss && DATABASE_URL='file:./test.db?connection_limit=1' node --import tsx --test test/e2e/*.test.ts",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "smoke": "tsx scripts/smoke-test.ts",
    "cf:types": "wrangler types",
    "cf:typecheck": "prisma generate && wrangler types && tsc --noEmit -p worker/tsconfig.json",
    "cf:dev": "wrangler dev",
    "cf:db:migrate:local": "wrangler d1 migrations apply kyc-db --local",
    "cf:db:migrate:remote": "wrangler d1 migrations apply kyc-db --remote",
    "cf:deploy": "prisma generate && wrangler deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "zod": "^3.25.0",
    "@prisma/adapter-d1": "6.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.0",
    "prisma": "^6.16.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "wrangler": "4.149.0"
  }
}
